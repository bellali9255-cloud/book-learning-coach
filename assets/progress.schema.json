{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/book-learning-coach/progress.schema.json",
  "title": "book-learning-coach progress state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book_id",
    "book",
    "source",
    "learning_cursor",
    "reading_cursor",
    "last_invocation",
    "reading_scope",
    "reading_lens",
    "chapters",
    "lessons",
    "review_cards",
    "audit",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "book_id": {"$ref": "#/$defs/book_id"},
    "book": {"$ref": "#/$defs/book"},
    "source": {"$ref": "#/$defs/source"},
    "learning_cursor": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/learning_cursor"}
      ]
    },
    "reading_cursor": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/reading_cursor"}
      ]
    },
    "last_invocation": {"$ref": "#/$defs/last_invocation"},
    "reading_scope": {"$ref": "#/$defs/reading_scope"},
    "reading_lens": {"$ref": "#/$defs/reading_lens"},
    "chapters": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/chapter_id"},
      "additionalProperties": {"$ref": "#/$defs/chapter"}
    },
    "lessons": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/lesson_id"},
      "additionalProperties": {"$ref": "#/$defs/lesson"}
    },
    "review_cards": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/review_card_id"},
      "additionalProperties": {"$ref": "#/$defs/review_card"}
    },
    "audit": {"$ref": "#/$defs/audit"},
    "updated_at": {"$ref": "#/$defs/empty_or_timestamp"}
  },
  "$defs": {
    "book_id": {"type": "string", "pattern": "^book_[0-9a-f]{8}$"},
    "chapter_id": {"type": "string", "pattern": "^ch_[0-9a-f]{8}$"},
    "lesson_id": {"type": "string", "pattern": "^lesson_[0-9a-f]{8}$"},
    "source_block_id": {"type": "string", "pattern": "^src_[0-9a-f]{8}$"},
    "attempt_id": {"type": "string", "pattern": "^attempt_[0-9a-f]{8}$"},
    "question_id": {"type": "string", "pattern": "^q_[0-9a-f]{8}$"},
    "rubric_point_id": {"type": "string", "pattern": "^rp_[0-9a-f]{8}$"},
    "review_card_id": {"type": "string", "pattern": "^review_[0-9a-f]{8}$"},
    "method_id": {"type": "string", "pattern": "^method_[0-9a-f]{8}$"},
    "cycle_id": {"type": "string", "pattern": "^cycle_[0-9a-f]{8}$"},
    "sha256": {
      "type": "string",
      "anyOf": [
        {"const": ""},
        {"pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "empty_or_timestamp": {
      "anyOf": [
        {"const": ""},
        {"$ref": "#/$defs/timestamp"}
      ]
    },
    "nullable_timestamp": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/timestamp"}
      ]
    },
    "mode": {"enum": ["browse", "intensive", "breakdown"]},
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "author", "language"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "author": {"type": "string"},
        "language": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_path",
        "original_sha256",
        "canonical_path",
        "canonical_sha256",
        "converter",
        "converter_version"
      ],
      "properties": {
        "original_path": {"type": "string", "minLength": 1},
        "original_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_path": {"type": "string", "minLength": 1},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "converter": {"type": "string"},
        "converter_version": {"type": "string"}
      }
    },
    "learning_cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "chapter_id", "lesson_id", "phase", "last_completed_action", "updated_at"],
      "properties": {
        "mode": {"const": "intensive"},
        "chapter_id": {"$ref": "#/$defs/chapter_id"},
        "lesson_id": {"$ref": "#/$defs/lesson_id"},
        "phase": {
          "enum": ["assess", "explain", "feynman", "quiz", "remediate", "distill", "record", "schedule_review", "complete"]
        },
        "last_completed_action": {"type": ["string", "null"]},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "reading_cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "chapter_id", "phase", "last_completed_action", "updated_at"],
      "properties": {
        "mode": {"enum": ["browse", "breakdown"]},
        "chapter_id": {"$ref": "#/$defs/chapter_id"},
        "phase": {
          "enum": ["inspect", "map_toc", "prioritize", "chapter_read", "chapter_notes", "audit", "complete"]
        },
        "last_completed_action": {"type": ["string", "null"]},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "last_invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_ids", "at"],
      "properties": {
        "method_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/method_id"}
        },
        "at": {"$ref": "#/$defs/empty_or_timestamp"}
      }
    },
    "reading_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included_chapter_ids", "excluded_chapter_ids", "exclusion_reasons"],
      "properties": {
        "included_chapter_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/chapter_id"}
        },
        "excluded_chapter_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/chapter_id"}
        },
        "exclusion_reasons": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/chapter_id"},
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "reading_lens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "supporting"],
      "properties": {
        "primary": {
          "enum": ["distillation", "sop", "scene-mapping", "cognitive-refresh", "communication-game"]
        },
        "supporting": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["distillation", "sop", "scene-mapping", "cognitive-refresh", "communication-game"]
          }
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_id", "title", "display_order", "browse_status", "deep_read_status", "source_block_ids"],
      "properties": {
        "chapter_id": {"$ref": "#/$defs/chapter_id"},
        "title": {"type": "string", "minLength": 1},
        "display_order": {"type": "integer", "minimum": 0},
        "browse_status": {"enum": ["unseen", "skimmed", "mapped"]},
        "deep_read_status": {"enum": ["not_started", "partial", "complete", "audited", "needs_review"]},
        "source_block_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/source_block_id"}
        }
      }
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_sha256", "canonical_sha256"],
      "properties": {
        "original_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson_id",
        "chapter_id",
        "title",
        "status",
        "mastery",
        "source_hashes",
        "unresolved_must_know",
        "quiz_attempts",
        "review_card_ids"
      ],
      "properties": {
        "lesson_id": {"$ref": "#/$defs/lesson_id"},
        "chapter_id": {"$ref": "#/$defs/chapter_id"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["not_started", "in_progress", "mastered", "needs_review", "skipped_by_user", "waived"]},
        "mastery": {"type": "integer", "minimum": 0, "maximum": 100},
        "source_hashes": {"$ref": "#/$defs/source_hashes"},
        "unresolved_must_know": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "quiz_attempts": {
          "type": "array",
          "items": {"$ref": "#/$defs/quiz_attempt"}
        },
        "review_card_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/review_card_id"}
        }
      }
    },
    "rubric_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_id", "points", "earned_points", "must_know", "passed"],
      "properties": {
        "point_id": {"$ref": "#/$defs/rubric_point_id"},
        "points": {"type": "number", "exclusiveMinimum": 0},
        "earned_points": {"type": "number", "minimum": 0},
        "must_know": {"type": "boolean"},
        "passed": {"type": "boolean"}
      }
    },
    "quiz_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "rubric_points"],
      "properties": {
        "question_id": {"$ref": "#/$defs/question_id"},
        "rubric_points": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/rubric_point"}
        }
      }
    },
    "quiz_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "score", "must_know_passed", "passed", "items", "at"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/attempt_id"},
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "must_know_passed": {"type": "boolean"},
        "passed": {"type": "boolean"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/quiz_item"}
        },
        "at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "cycle_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "at"],
      "properties": {
        "passed": {"type": "boolean"},
        "at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "review_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_card_id",
        "lesson_id",
        "required",
        "review_stage",
        "review_status",
        "last_reviewed_at",
        "next_due_at",
        "source_hashes",
        "cycle_results"
      ],
      "properties": {
        "review_card_id": {"$ref": "#/$defs/review_card_id"},
        "lesson_id": {"$ref": "#/$defs/lesson_id"},
        "required": {"type": "boolean"},
        "review_stage": {"type": "integer", "minimum": 0, "maximum": 5},
        "review_status": {"enum": ["scheduled", "due", "needs_review", "mature"]},
        "last_reviewed_at": {"$ref": "#/$defs/nullable_timestamp"},
        "next_due_at": {"$ref": "#/$defs/nullable_timestamp"},
        "source_hashes": {"$ref": "#/$defs/source_hashes"},
        "cycle_results": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/cycle_id"},
          "additionalProperties": {"$ref": "#/$defs/cycle_result"}
        }
      }
    },
    "chapter_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "audited_at", "issues"],
      "properties": {
        "status": {"enum": ["not_started", "in_progress", "audited", "needs_review"]},
        "audited_at": {"$ref": "#/$defs/nullable_timestamp"},
        "issues": {"type": "array", "items": {"type": "string"}}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapters", "book_status"],
      "properties": {
        "chapters": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/chapter_id"},
          "additionalProperties": {"$ref": "#/$defs/chapter_audit"}
        },
        "book_status": {"enum": ["not_started", "in_progress", "incomplete", "audited", "needs_review"]}
      }
    }
  }
}
